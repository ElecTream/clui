{
  "name": "clui-win",
  "version": "0.3.0-win.0",
  "description": "Clui - Desktop UI for Claude Code (Windows fork)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Youssef2430/clui.git"
  },
  "bugs": {
    "url": "https://github.com/Youssef2430/clui/issues"
  },
  "homepage": "https://github.com/Youssef2430/clui#readme",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build --mode production && electron-builder --mac --dir",
    "dist:dmg": "electron-vite build --mode production && electron-builder --mac",
    "dist:win": "electron-vite build --mode production && electron-builder --win",
    "dist:win:nsis": "electron-vite build --mode production && electron-builder --win nsis",
    "dist:win:portable": "electron-vite build --mode production && electron-builder --win portable",
    "build-icons": "node scripts/build-icons.js",
    "doctor": "node scripts/doctor.js",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "katex": "^0.16.45",
    "node-pty": "^1.1.0",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tar": "^7.5.15",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.1"
  },
  "build": {
    "appId": "com.clui.app",
    "productName": "Clui",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "resources/**/*",
      "package.json",
      "!node_modules/@huggingface/transformers/.cache"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Youssef2430",
      "repo": "clui"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Clui uses your microphone to transcribe voice input locally with Whisper."
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clui",
      "uninstallDisplayName": "Clui",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Clui-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "patch-package": "^8.0.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
